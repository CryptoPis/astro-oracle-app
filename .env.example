# ── Environment ─────────────────────────────────────────────
ENV=production                 # development | production
LOG_LEVEL=INFO

# ── Telegram ───────────────────────────────────────────────
BOT_TOKEN=123456:replace-me
BOT_USERNAME=astrogm2026bot
MINI_APP_SHORT_NAME=app        # from BotFather /newapp → t.me/<bot>/<short_name>
ADMIN_IDS=111111111            # comma-separated Telegram user IDs

# Public HTTPS base URL where this server is reachable (no trailing slash).
PUBLIC_BASE_URL=https://astro.example.com
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# How old initData may be before it is rejected (seconds).
INIT_DATA_MAX_AGE=86400

BOT_ENABLED=true
MORNING_PUSH_ENABLED=true
MORNING_PUSH_HOUR=9
SCHEDULER_TIMEZONE=Asia/Tbilisi

# ── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/astro.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/astro

# ── AI ─────────────────────────────────────────────────────
AI_PROVIDER=groq               # groq | mock (mock = offline dev, no API calls)
GROQ_API_KEY=gsk_replace-me
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_TIMEOUT_SECONDS=30

# ── CORS (only needed if index.html is hosted on another origin) ──
CORS_ORIGINS=

# ── Dev only: lets you open the app in a normal browser without Telegram.
# Ignored unless ENV=development.
DEV_AUTH_BYPASS=false
DEV_USER_ID=1
