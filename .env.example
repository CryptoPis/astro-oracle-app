# ── Environment ─────────────────────────────────────────────
ENV=production                 # development | production
LOG_LEVEL=INFO

# ── Telegram ───────────────────────────────────────────────
BOT_TOKEN=123456:replace-me
BOT_USERNAME=astrogm2026bot
MINI_APP_SHORT_NAME=app        # from BotFather /newapp → t.me/<bot>/<short_name>
ADMIN_IDS=111111111            # comma-separated Telegram user IDs

# Public HTTPS base URL (no trailing slash). On Render leave it empty: RENDER_EXTERNAL_URL is used.
PUBLIC_BASE_URL=https://astro.example.com
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# How old initData may be before it is rejected (seconds).
INIT_DATA_MAX_AGE=86400

BOT_ENABLED=true
# internal (scheduler inside the app) | external (cron-job.org calls /cron/morning?key=CRON_SECRET) | off
MORNING_PUSH_MODE=internal
MORNING_PUSH_HOUR=9
CRON_SECRET=change-me-to-another-long-random-string
SCHEDULER_TIMEZONE=Asia/Tbilisi

# ── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/astro.db
# Neon: paste the connection string exactly as Neon shows it; the app converts it for asyncpg.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── AI ─────────────────────────────────────────────────────
AI_PROVIDER=groq               # groq | mock (mock = offline dev, no API calls)
GROQ_API_KEY=gsk_replace-me
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=40

# ── CORS (only needed if index.html is hosted on another origin) ──
CORS_ORIGINS=

# ── Dev only: lets you open the app in a normal browser without Telegram.
# Ignored unless ENV=development.
DEV_AUTH_BYPASS=false
DEV_USER_ID=1
